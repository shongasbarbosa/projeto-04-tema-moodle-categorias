# Copie para .env e ajuste se necessário. Lido por scripts/lib/common.sh.

# Branch do Moodle a clonar em .moodle/moodle (não versionado).
MOODLE_BRANCH=MOODLE_405_STABLE

# Banco de dados usado pelo ambiente moodle-docker.
MOODLE_DOCKER_DB=pgsql
MOODLE_DOCKER_DB_VERSION=16

# Versão do PHP da imagem moodlehq/moodle-php-apache.
MOODLE_DOCKER_PHP_VERSION=8.3

# Porta do Moodle no host. Mude se 8000 já estiver em uso.
MOODLE_DOCKER_WEB_PORT=8000

# Credenciais do admin, usadas por scripts/install.ps1.
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=Categoriaboard@2026
MOODLE_ADMIN_EMAIL=admin@categoriaboard.local

# Credenciais de demonstração (professor.demo / aluno.demo) definidas em
# local/categoriaboarddemo/cli/seed.php: senha "Categoriaboard@2026".

{{!
    @template theme_categoriaboard/theme_boost/navbar

    Override of theme_boost/navbar that only adds the Sistema/Claro/Escuro
    theme switcher (before the language menu) and initialises
    theme_categoriaboard/thememode. Everything else is identical to
    theme_boost/navbar.

    Example context (json):
    {
        "output": {
            "should_display_navbar_logo": true,
            "get_compact_logo_url": "http://placekitten.com/50/50",
            "custom_menu": "<li>..</li>",
            "page_heading_menu": "<li>..</li>",
            "search_box": "<div><input type='text'></div>",
            "navbar_plugin_output": "<div class='dropdown'>Messaging</div>",
            "user_menu": "<div class='dropdown'>John Doe</div>"
        },
        "config": {
            "wwwroot": "#",
            "homeurl": "/my/"
        },
        "sitename": "Moodle Site",
        "mobileprimarynav": []
    }
}}
<nav class="navbar fixed-top navbar-light bg-white navbar-expand" aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="container-fluid">
        <button class="navbar-toggler aabtn d-block d-md-none px-1 my-1 border-0" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-primary">
            <span class="navbar-toggler-icon"></span>
            <span class="sr-only">{{#str}}sidepanel, core{{/str}}</span>
        </button>

        <a href="{{{ config.homeurl }}}" class="navbar-brand d-none d-md-flex align-items-center m-0 me-4 p-0 aabtn categoriaboard-header-logo">

            {{# output.should_display_navbar_logo }}
                <img src="{{output.get_compact_logo_url}}" class="logo me-1" alt="{{sitename}}">
            {{/ output.should_display_navbar_logo }}
            {{^ output.should_display_navbar_logo }}
                {{{ sitename }}}
            {{/ output.should_display_navbar_logo }}
        </a>
        {{#primarymoremenu}}
            <div class="primary-navigation">
                {{> core/moremenu}}
            </div>
        {{/primarymoremenu}}

        {{# output.page_heading_menu}}
            <ul class="navbar-nav d-none d-md-flex my-1 px-1">
                <!-- page_heading_menu -->
                {{{ output.page_heading_menu }}}
            </ul>
        {{/output.page_heading_menu}}

        <div id="usernavigation" class="navbar-nav ms-auto h-100">
            {{! Desktop: three buttons, one per mode (>=768px). }}
            <div
                class="categoriaboard-themeswitcher d-none d-md-flex align-items-center"
                role="group"
                aria-label="{{#str}} themepreference, theme_categoriaboard {{/str}}"
            >
                <button
                    type="button"
                    class="categoriaboard-themeswitcher__button"
                    data-categoriaboard-theme-button
                    data-mode="system"
                    aria-pressed="false"
                >{{#str}} themepreference_system, theme_categoriaboard {{/str}}</button>
                <button
                    type="button"
                    class="categoriaboard-themeswitcher__button"
                    data-categoriaboard-theme-button
                    data-mode="light"
                    aria-pressed="false"
                >{{#str}} themepreference_light, theme_categoriaboard {{/str}}</button>
                <button
                    type="button"
                    class="categoriaboard-themeswitcher__button"
                    data-categoriaboard-theme-button
                    data-mode="dark"
                    aria-pressed="false"
                >{{#str}} themepreference_dark, theme_categoriaboard {{/str}}</button>
            </div>

            {{! Mobile: a single button opening a dropdown with the same three options (<768px). }}
            <div class="dropdown categoriaboard-themeswitcher-mobile d-flex d-md-none align-items-center">
                <button
                    type="button"
                    class="btn btn-icon categoriaboard-themeswitcher-mobile__toggle"
                    data-toggle="dropdown"
                    data-base-label="{{#str}} themepreference, theme_categoriaboard {{/str}}"
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-label="{{#str}} themepreference, theme_categoriaboard {{/str}}"
                >
                    <i class="icon fa fa-adjust fa-fw" aria-hidden="true"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right">
                    <button
                        type="button"
                        class="dropdown-item"
                        data-categoriaboard-theme-button
                        data-mode="system"
                        aria-pressed="false"
                    >{{#str}} themepreference_system, theme_categoriaboard {{/str}}</button>
                    <button
                        type="button"
                        class="dropdown-item"
                        data-categoriaboard-theme-button
                        data-mode="light"
                        aria-pressed="false"
                    >{{#str}} themepreference_light, theme_categoriaboard {{/str}}</button>
                    <button
                        type="button"
                        class="dropdown-item"
                        data-categoriaboard-theme-button
                        data-mode="dark"
                        aria-pressed="false"
                    >{{#str}} themepreference_dark, theme_categoriaboard {{/str}}</button>
                </div>
            </div>
            <div class="divider border-start h-75 align-self-center mx-1"></div>
            {{# output.search_box }}
                {{{ output.search_box }}}
                <div class="divider border-start h-75 align-self-center mx-1"></div>
            {{/output.search_box}}
            {{#langmenu}}
                {{> theme_boost/language_menu }}
                <div class="divider border-start h-75 align-self-center mx-1"></div>
            {{/langmenu}}
            {{{ output.navbar_plugin_output }}}
            <div class="d-flex align-items-stretch usermenu-container" data-region="usermenu">
                {{#usermenu}}
                    {{> core/user_menu }}
                {{/usermenu}}
            </div>
            {{{ output.edit_switch }}}
        </div>
    </div>
</nav>

{{> theme_boost/primary-drawer-mobile }}

{{#js}}
require(['theme_categoriaboard/thememode'], function(ThemeMode) {
    ThemeMode.init();
});
{{/js}}

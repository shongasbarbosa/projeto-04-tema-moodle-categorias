{{!
    @template theme_categoriaboard/theme_boost/head

    Override of theme_boost/head that only adds one thing: a tiny, blocking
    inline script that applies the saved Sistema/Claro/Escuro preference to
    <html> before standard_head_html (and therefore before the page's CSS
    takes effect), so there is no flash of the wrong color scheme. Everything
    else is identical to theme_boost/head.

    Example context (json):
    {
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Test page",
            "favicon": "favicon.ico"
        }
    }
}}
{{{ output.doctype }}}
<html {{{ output.htmlattributes }}}>
<head>
    <script>
        (function() {
            try {
                var stored = localStorage.getItem('theme_categoriaboard_preference');
                var mode = (stored === 'light' || stored === 'dark') ? stored : 'system';
                var resolved = mode === 'system'
                    ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
                    : mode;
                document.documentElement.setAttribute('data-categoriaboard-theme', resolved);
            } catch (e) {
                document.documentElement.setAttribute('data-categoriaboard-theme', 'light');
            }
        })();
    </script>
    <title>{{{ output.page_title }}}</title>
    <link rel="shortcut icon" href="{{{ output.favicon }}}" />
    {{{ output.standard_head_html }}}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

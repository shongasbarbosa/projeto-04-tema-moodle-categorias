{{!
    @template theme_categoriaboard/course_card

    A single course card, with an accessible progress bar.

    Context variables required for this template:
    * id - int
    * fullname - string
    * url - string
    * imageurl - string
    * hasprogress - bool
    * progress - int|null, 0-100
    * progresslabel - string

    Example context (json):
    {
        "id": 10,
        "fullname": "PHP para EaD",
        "url": "#",
        "imageurl": "#",
        "hasprogress": true,
        "progress": 42,
        "progresslabel": "42%"
    }
}}
<article class="categoriaboard-card">
    <a class="categoriaboard-card__link" href="{{url}}">
        <span class="categoriaboard-card__image" style="background-image: url('{{imageurl}}');" aria-hidden="true"></span>
        <span class="categoriaboard-card__body">
            <span class="categoriaboard-card__title">{{fullname}}</span>
            {{#hasprogress}}
                <span class="categoriaboard-progress">
                    <span
                        class="categoriaboard-progress__bar"
                        role="progressbar"
                        aria-valuemin="0"
                        aria-valuemax="100"
                        aria-valuenow="{{progress}}"
                        aria-label="{{#str}} progressof, theme_categoriaboard, {{fullname}} {{/str}}"
                    >
                        <span class="categoriaboard-progress__fill" style="width: {{progress}}%;"></span>
                    </span>
                    <span class="categoriaboard-progress__label">{{progresslabel}}</span>
                </span>
            {{/hasprogress}}
            {{^hasprogress}}
                <span class="categoriaboard-progress categoriaboard-progress--none">{{progresslabel}}</span>
            {{/hasprogress}}
        </span>
    </a>
</article>

{{!
    @template theme_categoriaboard/category_board

    The student's "my courses grouped by category" panel.

    Context variables required for this template:
    * hasgroups - bool
    * groups - array of exported category_group

    Example context (json):
    {
        "hasgroups": true,
        "groups": [
            {
                "categoryid": 2,
                "categoryname": "Programação",
                "color": "#1E4FD8",
                "hascourses": true,
                "coursecount": 1,
                "courses": [
                    {
                        "id": 10,
                        "fullname": "PHP para EaD",
                        "url": "#",
                        "imageurl": "#",
                        "hasprogress": true,
                        "progress": 42,
                        "progresslabel": "42%"
                    }
                ]
            }
        ]
    }
}}
<section class="categoriaboard-board" aria-label="{{#str}} mycoursesbycategory, theme_categoriaboard {{/str}}">
    {{!
        No visible heading here on purpose: the page itself already renders
        one (see theme/categoriaboard/pages/painel.php, $PAGE->set_heading())
        through Boost's standard page header. Repeating it here duplicated
        the title on the page.
    }}
    {{^hasgroups}}
        <div class="categoriaboard-empty" role="status">
            <p>{{#str}} emptystate_nocourses, theme_categoriaboard {{/str}}</p>
        </div>
    {{/hasgroups}}

    {{#hasgroups}}
        {{#groups}}
            {{> theme_categoriaboard/category_group }}
        {{/groups}}
    {{/hasgroups}}
</section>
